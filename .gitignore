# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# VitePress
.vitepress/
docs/.vitepress/dist
docs/.vitepress/cache
docs/public/coverage

# Coverage
coverage/

# CodeWhale (instructions tracked, cache & state not)
.codewhale/*.cache
.codewhale/state/

# SpecKit (generated, not tracked)
.specify/

# MemPalace
.mempalace/
entities.json
chroma.sqlite3
b6d1e2c9-5c4e-4f38-a34d-612606e04378/

# Operator scripts (user-executed, not tracked)
operator-execute.sh
operator-log
