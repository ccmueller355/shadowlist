{
  "name": "shadowlist",
  "version": "0.19.5",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.0.0",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.12",
    "expo-dev-client": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "mermaid": "^11.15.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.13.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.41",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "jest": "~29.7.0",
    "jest-expo": "^57.0.0",
    "react-test-renderer": "^19.2.3",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "docs:build:full": "npm run test:coverage && cp -r coverage/lcov-report docs/public/coverage && vitepress build docs",
    "typecheck": "tsc --noEmit",
    "version": "node -e \"const p=require('./package.json'); const a=require('./app.json'); a.expo.version=p.version; require('fs').writeFileSync('./app.json', JSON.stringify(a, null, 2)+'\\n'); console.log('app.json synced to '+p.version);\"",
    "sync-version": "node -e \"const fs=require('fs'); const v=fs.readFileSync('VERSION','utf8').trim(); const files=['app.json','app.json.apk','app.json.expo']; files.forEach(f=>{const j=JSON.parse(fs.readFileSync(f,'utf8')); j.expo.version=v; fs.writeFileSync(f,JSON.stringify(j,null,2)+'\\n'); console.log(f+' → '+v)}); const p=JSON.parse(fs.readFileSync('package.json','utf8')); p.version=v; fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n'); console.log('package.json → '+v);\""
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-draggable-flatlist|react-native-gesture-handler|react-native-reanimated|react-native-screens|react-native-safe-area-context|react-native-toast-message|react-native-paper|react-native-vector-icons|react-native-worklets|zustand)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/constants/demoData.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 55,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
